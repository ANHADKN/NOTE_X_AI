# noteX AI Environment Configuration Template

# Application Settings
FLASK_ENV=production
SECRET_KEY=your-super-secret-app-key-change-in-production
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
PORT=5000

# Database Settings
MONGO_URI=mongodb://mongodb:27017/notex_ai
MONGO_DB_NAME=notex_ai

# Vector DB Settings
CHROMA_PERSIST_DIR=/app/data/chroma

# OpenAI API Settings
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Security Settings
ALLOWED_ORIGINS=*
MAX_CONTENT_LENGTH=16777216  # 16 MB limit for PDF uploads
